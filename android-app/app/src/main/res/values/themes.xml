<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TsProxy" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Matches Theme.kt's light background; the Compose theme takes over
             once the user's persisted theme mode has been read. -->
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
    </style>
</resources>
